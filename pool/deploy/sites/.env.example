# The three sites of Open Pool. Copy to .env and fill in.

# --- Images: what you pushed, by tag. pool/build-images.sh prints them. ---
MARKETING_IMAGE=tztcloud/openpool-web-marketing:0.1.0
MEMBER_IMAGE=tztcloud/openpool-web-member:0.1.0
ADMIN_IMAGE=tztcloud/openpool-web-admin:0.1.0

# --- Names ---
# The public site's pages were written with its own address and the member
# site's when its image was built (OPENPOOL_SITE_URL, OPENPOOL_MEMBER_URL):
# these must be the same.
MARKETING_SITE_HOST=open-pool.com
MEMBER_SITE_HOST=app.open-pool.com
ADMIN_SITE_HOST=admin.open-pool.com

# --- Traefik ---
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
